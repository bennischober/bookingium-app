{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "opencode-plugin-litellm@1.4.2"
  ],
  "providers": {
    "litellm": {
      "name": "LiteLLM",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.prod.orthos.uni-ulm.de/v1",
        "apiKey": "{file:orthos-key}"
      }
    }
  },
  "lsp": true,
  "mcp": {
    "servers": {
      "litellm-tools": {
        "type": "remote",
        "url": "https://api.prod.orthos.uni-ulm.de/mcp",
        "oauth": false,
        "headers": {
          "x-litellm-api-key": "Bearer {file:orthos-key}"
        }
      }
    }
  }
}